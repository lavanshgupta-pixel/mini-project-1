<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>

<body>
    <div class="w-full min-h-screen text-white p-10 bg-zinc-800">
        <div class="w-full gap-2 flex justify-end">
            <a class="bg-red-500 rounded-md px-3 py-2" href="/logout">Logout</a>
            <a class="bg-yellow-500 rounded-md  px-3 py-2 " href="/profile/upload">Edit PFP</a>
        </div>
        <h1 clasS="text-3xl p-6 ">PROFILE PAGE</h1>
        <div class="flex items-start gap-3">
          <div class="w-10 h-10  rounded-md">
            <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profilepic %>" />
          </div>
        <h3> <span class="text-2xl">Hello </span>, <%= user.name %> 😊</h3>
        </div>
        
        <h5 class="mt-5">You can create a new post</h5>
        <!-- creating post  -->
        <form action="/post" method="post">
            <textarea
                class=" w-1/3 resize-none bg-transparent text-white border-2 border-transparent outline-none p-3 bg-zinc-700"
                name="content" placeholder="What's on your mind?"></textarea>
            <input class="bg-blue-600 px-3 py-2 block rounded-md text-sm w-40 " value="Crete Post" type="submit">
        </form>
        <div class="posts mt-32">
            <h1 class="text-3xl text-zinc-400 ">Your Posts..</h1>
            <div class="postcontainer mt-8">
                <% user.posts.reverse().forEach((post)=>{ %>
                    <div class="post w-1/3 p-5 border-2 mb-3  border-zinc-700 bg-zinc-700 rounded-md">
                        <h4 class="text-blue-500 mb-2">@<%= user.username %>
                        </h4>
                        <p class="text-sm tracking-tight">
                            <%= post.content %>
                        </p>
                        <div class="btns gap-4 flex">
                            <span class=" block mt-2"> <%= post.likes.length%> likes</span>
                            <a class="text-blue-500 mt-2 " href="/post/<%= post._id%>">
                              <%= post.likes.indexOf(user._id)=== -1 ?"like" : "UnLike" %></a>
                            <a class="text-yellow-500 mt-2  " href="/edit/<%= post._id%>">Edit</a>
                        </div>




                    </div>
                    <% }) %>
                    
            </div>
        </div>

</body>

</html>