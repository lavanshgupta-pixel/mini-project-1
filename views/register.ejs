<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="w-full min-h-screen text-white p-10 bg-zinc-800" >
        <h1 clasS="text-3xl p-6">CREATE ACCOUNT</h1>
       <form action="/register"  method="post">
        <input class="px-3 py-2 outline-none bg-transparent border-2 rounded-md border-zinc-600" type="text" placeholder="username" name="username">
        <input class="px-3 py-2 outline-none bg-transparent border-2 rounded-md border-zinc-600" type="text" placeholder="name" name="name">
        <input class="px-3 py-2 outline-none bg-transparent border-2 rounded-md border-zinc-600" type="number" placeholder="age" name="age">
        <input class="px-3 py-2 outline-none bg-transparent border-2 rounded-md border-zinc-600" type="email" placeholder="email" name="email">
        <input class="px-3 py-2 outline-none bg-transparent border-2 rounded-md border-zinc-600" type="password" placeholder="password" name="password">
        <input class= "px-3 py-2 bg-blue-400 ml-10 rounded-md text-black "type="submit" value = "Create Account" >
        <a class = "px-3 py-2 bg-yellow-400 ml-10 rounded-md text-black" href="/login" >Login</a>
       </form>
    </div>
    
</body>
</html>