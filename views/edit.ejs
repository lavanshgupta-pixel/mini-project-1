<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>

<body>
    <div class="w-full min-h-screen text-white p-10 bg-zinc-800">
        <div class="w-full flex justify-end">
            <a class="bg-red-500 rounded-md px-3 py-2 text-sm" href="/logout">Logout</a>
        </div>
        <h1 clasS="text-3xl p-6 ">EDIT YOUR PROFILE</h1>
        <h3> <span class="text-2xl">Hello <%= post.user.name%> </span></h3>
        <h5 class="mt-5">You can edit your post  </h5>
        
        <form action="/update/<%=post._id%>" method="post">
            <textarea
                class=" w-1/3 resize-none bg-transparent text-white border-2 border-transparent outline-none p-3 bg-zinc-700"
                name="content" placeholder="What's on your mind?">
                 <%= post.content%></textarea>
            <input class="bg-yellow-600 px-3 text-black py-2 block rounded-md text-sm w-40 " value="Update Post" type="submit">
        </form>


</body>

</html>